<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема для светлого режима -->
    <style name="Base.Theme.ChessMentor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (зелёный ChessMentor) -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_onPrimary</item>
        <item name="colorPrimaryContainer">@color/brand_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/brand_onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_onSecondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/brand_onSecondaryContainer</item>

        <!-- Tertiary brand color (акцентный синий) -->
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_onTertiary</item>
        <item name="colorTertiaryContainer">@color/brand_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/brand_onTertiaryContainer</item>

        <!-- Error color -->
        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_onError</item>
        <item name="colorErrorContainer">@color/brand_errorContainer</item>
        <item name="colorOnErrorContainer">@color/brand_onErrorContainer</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_onBackground</item>

        <!-- Surface color -->
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_onSurface</item>
        <item name="colorSurfaceVariant">@color/brand_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/brand_onSurfaceVariant</item>

        <!-- Outline color -->
        <item name="colorOutline">@color/brand_outline</item>

        <!-- For splash screen -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background_light</item>
    </style>

    <!-- Тема для светлого режима -->
    <style name="Theme.ChessMentor" parent="Base.Theme.ChessMentor" />

    <!-- Тема для темного режима -->
    <style name="Theme.ChessMentor.Dark" parent="Base.Theme.ChessMentor">
        <item name="colorPrimary">@color/brand_dark_primary</item>
        <item name="colorOnPrimary">@color/brand_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/brand_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark_onPrimaryContainer</item>

        <item name="colorSecondary">@color/brand_dark_secondary</item>
        <item name="colorOnSecondary">@color/brand_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/brand_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark_onSecondaryContainer</item>

        <item name="colorTertiary">@color/brand_dark_tertiary</item>
        <item name="colorOnTertiary">@color/brand_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/brand_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/brand_dark_onTertiaryContainer</item>

        <item name="colorError">@color/brand_dark_error</item>
        <item name="colorOnError">@color/brand_dark_onError</item>
        <item name="colorErrorContainer">@color/brand_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/brand_dark_onErrorContainer</item>

        <item name="android:windowBackground">@color/brand_dark_background</item>
        <item name="colorOnBackground">@color/brand_dark_onBackground</item>

        <item name="colorSurface">@color/brand_dark_surface</item>
        <item name="colorOnSurface">@color/brand_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/brand_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/brand_dark_onSurfaceVariant</item>

        <item name="colorOutline">@color/brand_dark_outline</item>
    </style>

    <!-- Тема для Splash Screen -->
    <style name="Theme.ChessMentor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ChessMentor</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
